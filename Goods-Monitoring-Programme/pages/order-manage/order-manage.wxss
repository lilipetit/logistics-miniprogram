page {
  height: 100%;
  background-color: #000000;
}

.page-om {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #000000;
  overflow: hidden;
}

.om-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

.om-inner {
  padding: 16rpx var(--page-pad-h) calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.summary-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-cell {
  flex: 1;
  background-color: #1a1a1a;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  border: 1rpx solid #2a2a2a;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.summary-label {
  font-size: 22rpx;
  color: #999999;
}

.summary-val {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.summary-val.highlight {
  color: #ffb800;
}

.search-row {
  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background-color: #1a1a1a;
  border: 1rpx solid #333333;
  color: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-placeholder {
  color: #666666;
}

.filter-block {
  margin-bottom: 20rpx;
}

.filter-title {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 12rpx;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background-color: #1a1a1a;
  border: 1rpx solid #333333;
  box-sizing: border-box;
}

.filter.active {
  color: #ff6b00;
  border-color: #ff6b00;
  background-color: rgba(255, 107, 0, 0.15);
}

.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.btn-export {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #ff8c00 0%, #ff6b00 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-export::after {
  border: none;
}

.btn-refresh {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #ff6b00;
  border: 1rpx solid #ff6b00;
  border-radius: 40rpx;
  background-color: transparent;
  box-sizing: border-box;
}

.sub-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  margin: 8rpx 0 20rpx;
}

.pending-list {
  margin-bottom: 32rpx;
}

.pending-card {
  background-color: #1a1a1a;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #2a2a2a;
  box-sizing: border-box;
}

.pending-card__top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
}

.pending-card__idx {
  width: 52rpx;
  min-height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: rgba(255, 107, 0, 0.18);
  color: #ff6b00;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 14rpx;
}

.pending-card__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.pending-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.pending-card__no {
  font-size: 24rpx;
  color: #999999;
  word-break: break-all;
}

.pending-card__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #333333;
}

.btn-secondary {
  flex: 1;
  min-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background-color: transparent;
  color: #ff6b00;
  border: 2rpx solid #ff6b00;
}

.btn-secondary::after {
  border: none;
}

.btn-primary {
  flex: 1;
  min-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  background-color: #ff6b00;
  color: #ffffff;
  border: none;
}

.btn-primary::after {
  border: none;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background-color: #1a1a1a;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #2a2a2a;
  box-sizing: border-box;
}

.order-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.order-key {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999999;
}

.order-val {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  line-height: 1.45;
  word-break: break-word;
}

.order-val.em {
  color: #ffb800;
  font-weight: 600;
}

.pill {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-pending {
  background: rgba(255, 184, 0, 0.15);
  color: #ffb800;
}
.status-received {
  background: rgba(255, 107, 0, 0.15);
  color: #ff6b00;
}
.status-transit {
  background: rgba(255, 184, 0, 0.15);
  color: #ffb800;
}
.status-delivered {
  background: rgba(7, 193, 96, 0.15);
  color: #07c160;
}

.pay-pending {
  background: rgba(255, 107, 0, 0.15);
  color: #ff6b00;
}
.pay-success {
  background: rgba(7, 193, 96, 0.15);
  color: #07c160;
}
.pay-failed {
  background: rgba(255, 59, 48, 0.15);
  color: #ff3b30;
}

.order-ops {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #333333;
}

.mini-btn {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background-color: #ff6b00;
  color: #ffffff;
  border: none;
}

.mini-btn::after {
  border: none;
}

.mini-btn.pay {
  background-color: #ffb800;
  color: #000000;
}

.mini-btn.danger {
  background-color: #3a1a1a;
  color: #ff6b00;
  border: 1rpx solid rgba(255, 107, 0, 0.5);
}

.empty {
  padding: 48rpx 0;
  text-align: center;
}

.empty--small {
  padding: 28rpx 0;
}

.empty-text {
  color: #666666;
  font-size: 26rpx;
}
