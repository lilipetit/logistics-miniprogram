.page-update-status {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.update-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

.scroll-inner {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx var(--page-pad-h) 24rpx;
}

.tracking-section {
  margin-bottom: 60rpx;
}

.tracking-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.tracking-label {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 32rpx;
  line-height: 1.45;
}

.copy-btn {
  flex-shrink: 0;
  color: #ff6b00;
  font-size: 26rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid rgba(255, 107, 0, 0.55);
  border-radius: 14rpx;
  line-height: 1.2;
}

.status-timeline {
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 40rpx 0;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.status-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #1A1A1A;
  border: 4rpx solid #FFFFFF;
  margin-bottom: 20rpx;
  position: relative;
}

.status-item.active .status-circle {
  background-color: #FF6B00;
  border-color: #FF6B00;
}

.status-item.active .status-circle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
}

.status-text {
  color: #FFFFFF;
  font-size: 24rpx;
}

.status-item.active .status-text {
  color: #FF6B00;
}

.status-item.readonly {
  opacity: 0.6;
}

.status-item.readonly .status-circle {
  cursor: default;
}

.timeline-line {
  width: 60rpx;
  height: 2rpx;
  background-color: #FFFFFF;
  margin: 0 10rpx;
  margin-bottom: 60rpx;
}

.permission-tip {
  text-align: center;
  padding: 20rpx;
  margin-bottom: 40rpx;
  background-color: rgba(255, 184, 0, 0.1);
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 184, 0, 0.3);
}

.tip-text {
  color: #FFB800;
  font-size: 24rpx;
}

.details-section {
  margin-bottom: 60rpx;
}

.details-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  display: block;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #333333;
}

.detail-label {
  color: #FFFFFF;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.detail-value {
  flex: 1;
  color: #ffffff;
  font-size: 28rpx;
  text-align: right;
  margin-right: 20rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.detail-arrow {
  color: #666666;
  font-size: 28rpx;
}

.action-buttons {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 24rpx var(--page-pad-h);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #000000;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.action-btn {
  flex: 1;
  height: 80rpx;
  background-color: #FF6B00;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn::after {
  border: none;
}
