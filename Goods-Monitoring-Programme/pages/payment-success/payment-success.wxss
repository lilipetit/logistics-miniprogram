.container {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx var(--page-pad-h) calc(48rpx + env(safe-area-inset-bottom));
}

.success-icon-wrapper {
  margin-bottom: 60rpx;
}

.success-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C00 0%, #FF6B00 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(255, 107, 0, 0.5);
}

.checkmark {
  color: #FFFFFF;
  font-size: 120rpx;
  font-weight: bold;
  line-height: 1;
}

.success-text-section {
  text-align: center;
  margin-bottom: 100rpx;
}

.success-title {
  display: block;
  color: #FFB800;
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.success-subtitle {
  display: block;
  color: #FFFFFF;
  font-size: 32rpx;
  margin-bottom: 30rpx;
}

.order-number {
  display: block;
  color: #FFFFFF;
  font-size: 28rpx;
}

.action-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.view-order-btn,
.back-home-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.view-order-btn {
  background-color: #FF6B00;
  color: #FFFFFF;
}

.back-home-btn {
  background-color: #1A1A1A;
  color: #FFFFFF;
}

.view-order-btn::after,
.back-home-btn::after {
  border: none;
}
