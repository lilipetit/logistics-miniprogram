page {
  height: 100%;
  background-color: #000000;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.amount-section {
  padding: 24rpx var(--page-pad-h) 0;
  text-align: center;
}

.amount-value {
  display: block;
  color: #ffb800;
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1;
  margin-top: 24rpx;
}

.amount-sub {
  display: block;
  color: #cccccc;
  font-size: 26rpx;
  margin-top: 14rpx;
}

.qr-wrap {
  flex: 1;
  min-height: 200rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 24rpx var(--page-pad-h);
  box-sizing: border-box;
}

/* Skyline 下 aspectFit + height:auto 易出现高度为 0，widthFix 按宽度自适应高度更稳 */
.qr-image {
  width: 100%;
  max-width: 520rpx;
  display: block;
  border-radius: 24rpx;
}

.pay-actions {
  padding: 24rpx var(--page-pad-h) calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: #000000;
}

.pay-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background-color: #ff6b00;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
}

.pay-btn::after {
  border: none;
}

/* wxml 里按钮 class 名保持一致 */
.pay-btn,
.pay-actions .pay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-btn {
  padding: 0;
}
