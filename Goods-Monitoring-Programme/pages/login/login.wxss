.container {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  background-color: #000000;
  padding: 72rpx var(--page-pad-h) calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 80rpx;
}

.logo-image {
  width: 320rpx;
  height: auto;
  max-height: 160rpx;
  margin-bottom: 30rpx;
  border: 6rpx solid #FFB800;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.brand-name {
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-text {
  color: #FFB800;
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
}

.input-section {
  width: 100%;
  margin-bottom: 60rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background-color: #1A1A1A;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.input-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  color: #FFFFFF;
}

.input-field {
  flex: 1;
  color: #FFFFFF;
  font-size: 32rpx;
}

.input-placeholder {
  color: #999999;
}

.password-toggle {
  margin-left: 20rpx;
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-icon {
  font-size: 36rpx;
  opacity: 0.7;
}

.login-btn-wrapper {
  width: 100%;
  margin-bottom: 60rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(180deg, #FF8C00 0%, #FF6B00 100%);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.login-btn::after {
  border: none;
}

.register-link {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.register-text {
  color: #FFFFFF;
  margin-right: 10rpx;
}

.register-link-text {
  color: #FF6B00;
  text-decoration: underline;
}
