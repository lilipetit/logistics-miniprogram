.container {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx var(--page-pad-h) 260rpx;
}

.info-section {
  margin-bottom: 50rpx;
}

.section-title {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  display: block;
}

.address-input-wrapper {
  display: flex;
  align-items: center;
  background-color: transparent;
  border: 2rpx solid #FF6B00;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.location-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  color: #FF6B00;
}

.address-input {
  flex: 1;
  color: #ffffff;
  font-size: 30rpx;
}

.name-input-wrapper {
  margin-bottom: 18rpx;
}

.input-label {
  color: #FFFFFF;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  display: block;
}

.name-input {
  width: 100%;
  height: 80rpx;
  background-color: #1a1a1a;
  border-radius: 12rpx;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #666666;
}

.calculate-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding: 30rpx var(--page-pad-h);
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background-color: #000000;
  z-index: 50;
}

.calculate-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FF6B00;
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.calculate-btn::after {
  border: none;
}

/* 货品选择样式 */
.product-select-wrapper {
  margin-bottom: 30rpx;
}

.product-counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
}

.counter-btn {
  width: 72rpx;
  height: 72rpx;
  background-color: #FF6B00;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.counter-value {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: bold;
  min-width: 72rpx;
  text-align: center;
}

.price-display {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background-color: #1A1A1A;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.price-label {
  color: #FFFFFF;
  font-size: 28rpx;
}

.price-value {
  color: #FFB800;
  font-size: 40rpx;
  font-weight: bold;
  margin-left: 10rpx;
}

/* ========== 历史记录下拉 ========== */
.history-dropdown {
  width: 100%;
  background-color: #1a1a1a;
  border: 1rpx solid rgba(255, 107, 0, 0.25);
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.history-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 18rpx 16rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.3;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.history-row:last-child {
  border-bottom: none;
}

.history-row:active {
  background-color: rgba(255, 107, 0, 0.12);
}

.history-lines {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.92);
}

.history-del {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  margin-top: 4rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 107, 0, 0.5);
  color: #ff6b00;
  background-color: rgba(255, 107, 0, 0.08);
  font-size: 26rpx;
}

/* ========== 单价输入 ========== */
.unit-price-wrapper {
  margin-bottom: 30rpx;
}

.unit-price-input-wrapper {
  width: 100%;
  background-color: #1a1a1a;
  border-radius: 16rpx;
  padding: 0 0;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 107, 0, 0.55);
}

.unit-price-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 30rpx;
  background-color: transparent;
}
