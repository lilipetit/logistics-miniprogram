.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx var(--page-pad-h) calc(48rpx + env(safe-area-inset-bottom));
  background-color: #000000;
}

.hint-card {
  background-color: #1a1a1a;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(255, 107, 0, 0.25);
}

.hint-title {
  display: block;
  color: #ffb800;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.hint-desc {
  display: block;
  color: #cccccc;
  font-size: 26rpx;
  line-height: 1.5;
}

.field-block {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  color: #ffffff;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background-color: #1a1a1a;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 107, 0, 0.45);
  color: #ffffff;
  font-size: 30rpx;
}

.input-placeholder {
  color: #666666;
}

.preview-block {
  background-color: #111111;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 40rpx;
}

.preview-label {
  display: block;
  color: #888888;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.preview-value {
  color: #ff6b00;
  font-size: 30rpx;
  font-weight: bold;
}

.actions {
  margin-top: 20rpx;
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background-color: #ff6b00;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
