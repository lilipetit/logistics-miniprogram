/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow-x: hidden;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  box-sizing: border-box;
}

.scrollarea .container {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx var(--page-pad-h) calc(24rpx + env(safe-area-inset-bottom));
}
