<navigation-bar title="注册账号" back="{{true}}" color="white" background="#000000"></navigation-bar>
<view class="container">
  <!-- 注册成功提示 -->
  <view class="success-section" wx:if="{{registerSuccess}}">
    <view class="success-icon-wrapper">
      <view class="success-circle">
        <text class="checkmark">✓</text>
      </view>
    </view>
    <text class="success-title">注册成功！</text>
    <text class="success-desc">您的账号已创建，请前往登录</text>
    <view class="success-btn-wrapper">
      <button class="go-login-btn" bindtap="goToLogin">去登录</button>
    </view>
  </view>

  <!-- 注册表单 -->
  <view wx:else>
    <!-- 角色选择 -->
    <view class="role-section">
      <text class="section-title">角色选择:</text>
      <view class="role-buttons">
        <view 
          class="role-btn {{selectedRole === 'user' ? 'active' : ''}}"
          bindtap="selectRole"
          data-role="user"
        >
          用户
        </view>
        <view 
          class="role-btn {{selectedRole === 'courier' ? 'active' : ''}}"
          bindtap="selectRole"
          data-role="courier"
        >
          司机
        </view>
        <view 
          class="role-btn {{selectedRole === 'admin' ? 'active' : ''}}"
          bindtap="selectRole"
          data-role="admin"
        >
          管理员
        </view>
      </view>
    </view>

    <!-- 输入区域 -->
    <view class="input-section">
      <view class="input-item">
        <text class="input-label">手机号</text>
        <input 
          class="input-field" 
          type="number" 
          placeholder="#1A1A10" 
          placeholder-class="input-placeholder"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="input-item">
        <text class="input-label">用户名</text>
        <input 
          class="input-field" 
          placeholder="请输入用户名" 
          placeholder-class="input-placeholder"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>
      <view class="input-item">
        <text class="input-label">密码</text>
        <view class="password-input-wrapper">
          <input 
            class="input-field" 
            type="text"
            password="{{!showPassword}}"
            placeholder="请输入密码" 
            placeholder-class="input-placeholder"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
          <view class="password-toggle" bindtap="togglePassword">
            <text class="toggle-icon">{{showPassword ? '👁️' : '👁️‍🗨️'}}</text>
          </view>
        </view>
      </view>
      <view class="input-item">
        <text class="input-label">确认密码进入</text>
        <view class="password-input-wrapper">
          <input 
            class="input-field" 
            type="text"
            password="{{!showConfirmPassword}}"
            placeholder="请再次输入密码" 
            placeholder-class="input-placeholder"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
          />
          <view class="password-toggle" bindtap="toggleConfirmPassword">
            <text class="toggle-icon">{{showConfirmPassword ? '👁️' : '👁️‍🗨️'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 注册按钮 -->
    <view class="register-btn-wrapper">
      <button class="register-btn" bindtap="handleRegister">注册</button>
    </view>
  </view>
</view>
