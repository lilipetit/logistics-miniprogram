.container {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  background-color: #000000;
  padding: 24rpx var(--page-pad-h) calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.role-section {
  margin-bottom: 50rpx;
}

.section-title {
  color: #FFFFFF;
  font-size: 30rpx;
  margin-bottom: 24rpx;
  display: block;
}

.role-buttons {
  display: flex;
  gap: 16rpx;
}

.role-btn {
  flex: 1;
  height: 72rpx;
  background-color: #1A1A1A;
  border-radius: 12rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.role-btn.active {
  background-color: #1A1A1A;
  border-color: #FF6B00;
  color: #FF6B00;
}

.input-section {
  flex: 1;
  margin-bottom: 50rpx;
}

.input-item {
  margin-bottom: 32rpx;
}

.input-label {
  color: #FFFFFF;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  display: block;
}

.password-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #1A1A1A;
  border-radius: 10rpx;
  padding-right: 20rpx;
}

.input-field {
  flex: 1;
  height: 80rpx;
  background-color: transparent;
  border-radius: 12rpx;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 30rpx;
  box-sizing: border-box;
}

.password-toggle {
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-icon {
  font-size: 32rpx;
  opacity: 0.7;
}

.input-placeholder {
  color: #666666;
}

.register-btn-wrapper {
  width: 100%;
  margin-bottom: 40rpx;
}

.register-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FF6B00;
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.register-btn::after {
  border: none;
}

/* 注册成功样式 */
.success-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.success-icon-wrapper {
  margin-bottom: 60rpx;
}

.success-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C00 0%, #FF6B00 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(255, 107, 0, 0.5);
}

.checkmark {
  color: #FFFFFF;
  font-size: 120rpx;
  font-weight: bold;
  line-height: 1;
}

.success-title {
  display: block;
  color: #FFB800;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.success-desc {
  display: block;
  color: #FFFFFF;
  font-size: 28rpx;
  margin-bottom: 80rpx;
  text-align: center;
  opacity: 0.8;
}

.success-btn-wrapper {
  width: 100%;
}

.go-login-btn {
  width: 100%;
  height: 100rpx;
  background-color: #FF6B00;
  border-radius: 50rpx;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.go-login-btn::after {
  border: none;
}
