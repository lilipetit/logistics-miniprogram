/* 扫码签收页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.content-scroll {
  height: 100vh;
  padding: 20rpx;
}

/* 模式切换 */
.scan-mode-switch {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.mode-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  border-radius: 12rpx;
  background: #f5f5f5;
  border: 2rpx solid transparent;
}

.mode-btn.active {
  background: #fff2e8;
  border-color: #FF6B00;
}

.mode-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.mode-text {
  font-size: 26rpx;
  color: #666;
}

.mode-btn.active .mode-text {
  color: #FF6B00;
  font-weight: bold;
}

/* 设备信息 */
.device-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f0f9eb;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 26rpx;
  color: #333;
}

.device-status {
  font-size: 24rpx;
  color: #52c41a;
}

/* 扫描状态 */
.scan-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.status-indicator {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #ccc;
  margin-right: 16rpx;
}

.status-indicator.scanning {
  background: #52c41a;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.2); }
  100% { opacity: 1; transform: scale(1); }
}

.status-text {
  font-size: 28rpx;
  color: #666;
  margin-right: 30rpx;
}

.manual-btn {
  font-size: 24rpx;
  color: #FF6B00;
  background: none;
  border: none;
  padding: 0;
}

/* 运单号显示 */
.tracking-display {
  text-align: center;
  padding: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.tracking-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.tracking-number {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #000;
  letter-spacing: 4rpx;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fafafa;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  color: #666;
}

.order-status.delivered {
  background: #f0f9eb;
  color: #52c41a;
}

.order-status.transit {
  background: #e6f7ff;
  color: #1890ff;
}

.order-status.received {
  background: #fff7e6;
  color: #fa8c16;
}

.card-body {
  padding: 24rpx 30rpx;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.info-value.address {
  line-height: 1.5;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.sign-btn {
  flex: 2;
  height: 88rpx;
  background: #52c41a;
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sign-btn.disabled {
  background: #ccc;
}

.print-btn {
  flex: 1;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #FF6B00;
  border-radius: 44rpx;
  color: #FF6B00;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 历史记录 */
.history-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.history-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  flex: 1;
}

.history-tracking {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.history-receiver {
  font-size: 22rpx;
  color: #999;
}

.history-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 摄像头扫码浮窗 */
.camera-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  background: #FF6B00;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.4);
}

.camera-fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 48rpx;
  margin-bottom: 6rpx;
}

.fab-text {
  font-size: 22rpx;
  color: #fff;
}
