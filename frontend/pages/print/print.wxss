/* 打印页面样式 */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.content-scroll {
  height: calc(100vh - 120rpx);
}

/* 面单预览 */
.label-preview {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.preview-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #eee;
}

.preview-header {
  text-align: center;
  padding: 30rpx 0;
  border-bottom: 4rpx dashed #ddd;
}

.preview-tracking {
  font-size: 40rpx;
  font-weight: bold;
  color: #000;
  letter-spacing: 4rpx;
}

.preview-section {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #FF6B00;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #FF6B00;
}

.section-content {
  padding-left: 10rpx;
}

.info-row {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 48rpx;
}

.preview-footer {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B00;
}

.preview-time {
  font-size: 24rpx;
  color: #999;
}

.preview-empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 打印机选择 */
.printer-section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.printer-status {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f0f9eb;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #999;
  margin-right: 16rpx;
}

.status-indicator.connected {
  background: #52c41a;
}

.status-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.change-btn {
  font-size: 24rpx;
  color: #FF6B00;
  background: none;
  border: none;
  padding: 0;
}

.printer-search {
  margin-top: 20rpx;
}

.search-btn {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border: 2rpx solid #FF6B00;
  border-radius: 40rpx;
  color: #FF6B00;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn:active {
  background: #fff2e8;
}

.printer-list {
  margin-top: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  overflow: hidden;
}

.printer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid #eee;
  background: #fff;
}

.printer-item:last-child {
  border-bottom: none;
}

.printer-item:active {
  background: #f5f5f5;
}

.printer-info {
  flex: 1;
}

.printer-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.printer-rssi {
  font-size: 24rpx;
  color: #999;
}

.printer-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 打印历史 */
.history-section {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.history-list {
  margin-top: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 2rpx solid #eee;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  flex: 1;
}

.history-tracking {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.history-time {
  font-size: 22rpx;
  color: #999;
}

.reprint-btn {
  font-size: 24rpx;
  color: #FF6B00;
  background: none;
  border: none;
  padding: 0;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.copy-btn {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  color: #666;
  font-size: 28rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.print-btn {
  flex: 2;
  height: 80rpx;
  background: #FF6B00;
  border-radius: 40rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.print-btn.disabled {
  background: #ccc;
}

.print-btn:active:not(.disabled) {
  background: #e65f00;
}
